#!/bin/bash
########## Define Resources Needed with SBATCH Lines ##########
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=1-41
#SBATCH --cpus-per-task=12
#SBATCH -t 02:00:00
#SBATCH --mem=10GB
#SBATCH --job-name=ec_t80
#SBATCH -p defq,moore
#SBATCH --exclude=esplhpc-cp040
###############################################################

# load conda environment
source ~/anaconda3/etc/profile.d/conda.sh
conda activate agp-ps

# Tournament size
TASK=Energy-C
T_SIZE=500
T_SCALE=0.8
PROPORTION=80

# Define the selector and output directory (they are the same here)
MAIN_DIR=~/Repos/Scaling-Tournament-Selection/
DATA_DIR=${MAIN_DIR}DATA/${TASK}/
REP_DIR=${MAIN_DIR}Experiments/Scaling/${TASK}/Splits/Rep_${SLURM_ARRAY_TASK_ID}/
RESULTS_DIR=${MAIN_DIR}RESULTS/${TASK}/Scaling/T${PROPORTION}/Rep_${SLURM_ARRAY_TASK_ID}/
mkdir -p ${RESULTS_DIR}

# Seed param offset
OFFSET=$((41*1002))
SEED=$((SLURM_ARRAY_TASK_ID + OFFSET))

# let it rip
python ~/Repos/Scaling-Tournament-Selection/Source/gp.py \
--data_dir ${DATA_DIR} \
--split_dir ${REP_DIR} \
--selection t \
--t_size ${T_SIZE} \
--seed ${SEED} \
--output_dir ${RESULTS_DIR} \
--n_cpus 12 \
--t_scale ${T_SCALE}